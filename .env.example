# Application
APP_NAME=FaceAttendanceAI
APP_VERSION=1.0.0
DEBUG=true

# AI
AI_DEVICE=cuda
FACE_DETECTION_MODEL=scrfd
FACE_RECOGNITION_MODEL=buffalo_l

# Recognition
FACE_MATCH_THRESHOLD=0.45
FACE_DETECTION_THRESHOLD=0.50

# Attendance
ATTENDANCE_COOLDOWN_SECONDS=300
MIN_CONSENSUS_FRAMES=5

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/face_attendance

# Redis
REDIS_URL=redis://localhost:6379/0
